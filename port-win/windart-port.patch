+// WINDART workspace liveness: hot-reload the current isolate's sources. Re-reads
+// the root script and its imports through the tag handler, recompiles changed
+// libraries, and morphs live instances to the new class shapes (InstanceMorpher
+// + Become). Returns null on success, or an error handle whose message is the
+// reload's cancellation report. From macdart-port.patch (OS-neutral hunk).
+DART_EXPORT Dart_Handle Dart_WorkspaceReloadSources(bool force_reload) {
+  DARTSCOPE(Thread::Current());
+  Isolate* isolate = T->isolate();
+  if (!isolate->CanReload()) {
+    return Api::NewError("%s: isolate cannot reload in its current state",
+                         CURRENT_FUNC);
+  }
+  JSONStream js;
+  bool success = isolate->ReloadSources(&js, force_reload);
+  if (!success) {
+    return Api::NewError("reload cancelled: %s", js.ToCString());
+  }
+  return Api::Success();
+}
+
+
+// WINDART workspace metrics: sample this isolate's live VM counters for the
+// toolbar (see dart_tools_api.h for the layout). Read straight off the isolate's
+// heap and compiler stats — a counter the VM cannot answer stays 0.
+DART_EXPORT Dart_Handle Dart_WorkspaceVmStats(int64_t* out, intptr_t count) {
+  if ((out == NULL) || (count < kDartWorkspaceVmStatCount)) {
+    return Api::NewError("%s: expects room for %d counters", CURRENT_FUNC,
+                         kDartWorkspaceVmStatCount);
+  }
+  DARTSCOPE(Thread::Current());
+  Isolate* isolate = T->isolate();
+  Heap* heap = isolate->heap();
+  const int64_t word = kWordSize;
+
+  out[0] = heap->UsedInWords(Heap::kNew) * word;
+  out[1] = heap->CapacityInWords(Heap::kNew) * word;
+  out[2] = heap->UsedInWords(Heap::kOld) * word;
+  out[3] = heap->CapacityInWords(Heap::kOld) * word;
+  out[4] = heap->new_space()->collections();
+  out[5] = heap->old_space()->collections();
+
+  out[6] = out[7] = out[8] = 0;
+  if (FLAG_support_compiler_stats && FLAG_compiler_stats) {
+    CompilerStats* cs = isolate->aggregate_compiler_stats();
+    if (cs != NULL) {
+      out[6] = cs->num_functions_compiled;
+      out[7] = cs->num_functions_optimized;
+      out[8] = cs->total_instr_size;
+    }
+  }
+  return Api::Success();
+}
